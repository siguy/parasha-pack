{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parasha-pack/schemas/extras.schema.json",
  "title": "Parasha Pack printable extras (decks/{id}/extras.yaml)",
  "type": "object",
  "required": ["deck_id", "vocab", "free_space", "ispy", "match", "listen_do"],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "en", "he", "translit", "item_prompt"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "en": {"type": "string", "minLength": 1},
        "he": {"type": "string", "pattern": "[֑-ׇ]", "description": "Hebrew WITH nikud"},
        "translit": {"type": "string", "pattern": "[A-Z]", "description": "stressed syllable in CAPS"},
        "item_prompt": {"type": "string", "minLength": 10},
        "deck_specific": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 12}
    },
    "box": {
      "type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1},
      "minItems": 4, "maxItems": 4
    }
  },
  "properties": {
    "deck_id": {"type": "string"},
    "vocab": {"type": "array", "items": {"$ref": "#/$defs/item"}, "minItems": 9, "maxItems": 16},
    "free_space": {"$ref": "#/$defs/item"},
    "bingo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boards": {"type": "integer", "minimum": 1, "maximum": 30},
        "max_shared": {"type": "integer", "minimum": 4, "maximum": 8},
        "simulations": {"type": "integer", "minimum": 100},
        "candidates": {"type": "integer", "minimum": 1},
        "target_median_first_win": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
        "max_avg_simultaneous_winners": {"type": "number"},
        "win_rule": {"enum": ["corners", "line", "blackout"]}
      }
    },
    "ispy": {
      "type": "object",
      "required": ["background_prompt", "zones", "item_zones", "easy", "challenge"],
      "additionalProperties": false,
      "properties": {
        "background_prompt": {"type": "string"},
        "zones": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        },
        "item_zones": {"type": "object", "additionalProperties": {"type": "string"}},
        "easy": {
          "type": "object", "required": ["targets"], "additionalProperties": false,
          "properties": {"targets": {"$ref": "#/$defs/counts"}}
        },
        "challenge": {
          "type": "object", "required": ["targets"], "additionalProperties": false,
          "properties": {"targets": {"$ref": "#/$defs/counts"}, "distractors": {"$ref": "#/$defs/counts"}}
        }
      }
    },
    "match": {
      "type": "object",
      "required": ["modes", "pairs", "sets"],
      "additionalProperties": false,
      "properties": {
        "modes": {"type": "array", "items": {"enum": ["pic_pic", "pic_word"]}},
        "pairs": {"const": 6},
        "sets": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 6, "maxItems": 6}
        },
        "bonus_days": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "required": ["day", "he", "item"], "additionalProperties": false,
            "properties": {"day": {"type": "integer"}, "he": {"type": "string"}, "item": {"type": "string"}}
          }
        }
      }
    },
    "listen_do": {
      "type": "object",
      "required": ["scene_prompt", "objects", "steps"],
      "additionalProperties": false,
      "properties": {
        "scene_prompt": {"type": "string"},
        "objects": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "en", "pos"], "additionalProperties": false,
            "properties": {
              "id": {"type": "string"}, "en": {"type": "string"}, "he": {"type": "string"},
              "translit": {"type": "string"}, "pos": {"$ref": "#/$defs/box"}
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object", "required": ["level", "text", "expected"], "additionalProperties": false,
            "properties": {
              "level": {"enum": [1, 2]},
              "text": {"type": "string"},
              "expected": {
                "type": "array", "minItems": 1, "maxItems": 3,
                "items": {
                  "type": "object", "required": ["object", "action"], "additionalProperties": false,
                  "properties": {
                    "object": {"type": "string"},
                    "action": {"enum": ["color", "draw", "mark"]},
                    "color": {"type": "string"},
                    "label": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
