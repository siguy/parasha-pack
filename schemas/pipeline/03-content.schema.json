{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parasha-pack/schemas/pipeline/03-content.schema.json",
  "title": "Pipeline step 03: Content Writer (English + Hebrew)",
  "description": "decks/<id>/pipeline/03-content.yaml. Per card: titles, the v3 back and the guide block. Back and guide reuse the definitions in schemas/deck.v3.schema.json, so the shapes can never drift apart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "deck_id", "cards"],
  "properties": {
    "agent": { "const": "03-content-writer" },
    "deck_id": { "type": "string" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "title_en", "title_he", "back", "guide"],
        "properties": {
          "card_id": { "type": "string", "pattern": "^[a-z_]+_[0-9]+$" },
          "title_en": { "type": "string" },
          "title_he": { "type": "string", "description": "With nikud" },
          "hebrew_keyword": {
            "type": "object",
            "additionalProperties": false,
            "required": ["word", "translit", "meaning"],
            "properties": { "word": { "type": "string" }, "translit": { "type": "string" }, "meaning": { "type": "string" } }
          },
          "back": {
            "description": "Home card: ../deck.v3.schema.json#/$defs/home_back. Every other card: #/$defs/back (minutes and core must match 02-structure).",
            "anyOf": [
              { "$ref": "../deck.v3.schema.json#/$defs/back" },
              { "$ref": "../deck.v3.schema.json#/$defs/home_back" }
            ]
          },
          "guide": { "$ref": "../deck.v3.schema.json#/$defs/guide" }
        }
      }
    }
  }
}
